{
	"name": "gentle-timeline",
	"version": "0.1.0",
	"description": "Pi / gentle-shell extension: /timeline lists every prompt of the current session and jumps the transcript to that point.",
	"keywords": [
		"pi-package",
		"pi-extension",
		"gentle-shell",
		"timeline",
		"prompts"
	],
	"license": "MIT",
	"type": "module",
	"main": "./index.ts",
	"types": "./index.ts",
	"exports": {
		".": "./index.ts",
		"./package.json": "./package.json"
	},
	"files": [
		"index.ts",
		"src",
		"README.md"
	],
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"engines": {
		"node": ">=22.18.0"
	},
	"scripts": {
		"test": "node --test \"test/**/*.test.ts\"",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "npm test && npm run typecheck"
	},
	"devDependencies": {
		"@types/node": "^22.10.0",
		"typescript": "^5.9.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/LeninGR/gentle-timeline.git"
	},
	"bugs": {
		"url": "https://github.com/LeninGR/gentle-timeline/issues"
	},
	"homepage": "https://github.com/LeninGR/gentle-timeline#readme"
}
